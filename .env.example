# Kopiera till .env.local vid lokal utveckling.
# Supabase anon/publishable key är publik i frontend-appar.
# Service role, Stripe- och cronhemligheter ska aldrig ligga i en VITE_-variabel.

VITE_SUPABASE_URL=https://din-supabase-url.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=din-publishable-anon-key
VITE_SUPABASE_PROJECT_ID=din-project-id
VITE_PUBLIC_APP_URL=https://honsgarden.se
